<!-- Original SqueezeDrive launcher art (round variant): a road line curving
     into a music note, in instrument amber on a dark tile. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#171C20"
        android:pathData="M4,54a50,50 0,1 0,100 0a50,50 0,1 0,-100 0" />

    <!-- Road sweeping up into the note -->
    <path
        android:pathData="M22,86C32,82 40,79 46,77"
        android:strokeColor="#F2B24B"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- Note head -->
    <path
        android:fillColor="#F2B24B"
        android:pathData="M43,74a13,12 0,1 0,26 0a13,12 0,1 0,-26 0" />

    <!-- Stem -->
    <path
        android:pathData="M69,72L69,32"
        android:strokeColor="#F2B24B"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- Flag -->
    <path
        android:pathData="M69,32C78,38 82,44 83,52"
        android:strokeColor="#F2B24B"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

</vector>
