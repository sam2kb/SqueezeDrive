<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory android:title="@string/settings_category_server">

        <EditTextPreference
            android:key="server_name"
            android:title="@string/settings_server_name_title"
            android:dialogMessage="@string/settings_server_name_dialog_message" />

        <EditTextPreference
            android:key="server_url"
            android:title="@string/settings_server_url_title"
            android:summary="@string/settings_server_url_summary"
            android:dialogMessage="@string/settings_server_url_dialog_message" />

        <EditTextPreference
            android:key="user"
            android:title="@string/settings_server_user_title"
            android:dialogMessage="@string/settings_server_user_dialog_message" />

        <EditTextPreference
            android:key="password"
            android:title="@string/settings_server_password_title"
            android:dialogMessage="@string/settings_server_password_dialog_message"
            android:inputType="textPassword" />

        <Preference
            android:key="connection_status"
            android:title="@string/settings_connection_status_title"
            android:summary="@string/settings_connection_status_disconnected"
            android:selectable="false" />

        <Preference
            android:key="reconnect"
            android:title="@string/settings_reconnect_title"
            android:summary="@string/settings_reconnect_summary" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_local_player">

        <SwitchPreferenceCompat
            android:key="local_player_enabled"
            android:title="@string/settings_local_player_enabled_title"
            android:summary="@string/settings_local_player_enabled_summary"
            android:defaultValue="true" />

        <EditTextPreference
            android:key="local_player_name"
            android:title="@string/settings_local_player_name_title"
            android:dialogMessage="@string/settings_local_player_name_dialog_message"
            android:defaultValue="@string/settings_local_player_name_default"
            android:isPersistent="false" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_playback">

        <!-- IntListPreference keeps the selected entry value as an Int in the preference
             store, because the ported helpers read these keys with SharedPreferences.getInt(). -->
        <com.sam2kb.squeezedrive.ui.IntListPreference
            android:key="fade_in_duration"
            android:title="@string/settings_fade_in_title"
            android:entries="@array/settings_fade_in_entries"
            android:entryValues="@array/settings_fade_in_values"
            android:defaultValue="0"
            android:summary="%s" />

        <com.sam2kb.squeezedrive.ui.IntListPreference
            android:key="volume_step_size"
            android:title="@string/settings_volume_step_title"
            android:entries="@array/settings_volume_step_entries"
            android:entryValues="@array/settings_volume_step_values"
            android:defaultValue="5"
            android:summary="%s" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_category_about">

        <Preference
            android:title="@string/settings_about_title"
            android:summary="@string/settings_about_summary"
            android:selectable="false" />

    </PreferenceCategory>

</PreferenceScreen>
