<!--
  Night-cabin palette: a cool near-black base with one restrained accent, instrument
  amber (echoing the glow of classic Squeezebox displays). The accent is used for
  controls only; text stays neutral so album art carries the colour.
-->
<resources>
    <color name="sd_background">#0E1113</color>
    <color name="sd_surface">#15191C</color>
    <color name="sd_surface_high">#1D2226</color>
    <color name="sd_track">#333B40</color>
    <color name="sd_amber">#F2B24B</color>
    <color name="sd_amber_ink">#241A08</color>
    <color name="sd_text_primary">#ECF1F2</color>
    <color name="sd_text_secondary">#A7B2B7</color>
    <color name="sd_text_section">#C3CCD1</color>
</resources>
