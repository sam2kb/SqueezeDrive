<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Car-only application: it is meant to be installed on Android Automotive OS. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- INTERNET: Lyrion (LMS) web/API and cometd access on the LAN.
         WAKE_LOCK: slimproto streaming keeps the device awake while playing.
         FOREGROUND_SERVICE*: the local player and media session run as foreground
         media playback services. POST_NOTIFICATIONS: their state notifications. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.wittyfinch.squeezedrive.SqueezeDriveApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="audio"
        android:theme="@style/Theme.SqueezeDrive"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic: Lyrion music servers on the LAN are usually plain HTTP
             (web/API port 9000, slimproto 3483), so cleartext must stay allowed. -->

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <service
            android:name="com.wittyfinch.squeezedrive.media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <service
            android:name="de.maniac103.squeezeclient.service.localplayer.LocalPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Parked settings only. Not distraction-optimized on purpose: it is not
             meant to be used while driving, and has no MAIN/LAUNCHER intent filter
             because the car's media host owns the driving experience. -->
        <activity
            android:name="com.wittyfinch.squeezedrive.ui.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.SqueezeDrive">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
